  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "audit:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release-check.ps1",
    "audit:profiles": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/profile-check.ps1",
    "audit:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/native-boundary-check.ps1",
    "audit:desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-native-check.ps1",
    "audit:kernel": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/kernel-boundary-check.ps1",
    "native:wfp:smoke": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/tests/run-wfp-smoke.ps1",
    "proxy:pool:smoke": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/proxy-pool-smoke.ps1",
    "proxy:relay:smoke": "node scripts/proxy-relay-smoke.js",
    "kernel:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/kernel/build-driver.ps1",
    "kernel:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/kernel/install-driver.ps1",
    "kernel:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/kernel/install-driver.ps1 -Uninstall",
    "kernel:smoke": ".\\native\\kernel\\bin\\kernel-smoke.exe"
  },
